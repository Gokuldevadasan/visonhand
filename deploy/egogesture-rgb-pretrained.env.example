# Settings for "Pretrained RGB detector + classifier models" from the README.
# This classifier is accurate but too large for responsive real-time Pi 4 use.
PROJECT_DIR=/opt/gesture-recognition
MODEL_PATH=/opt/gesture-recognition/Pretrained models/egogesture_resnext_101_RGB_32.pth
CAMERA_SOURCE=0
MODEL=resnext
MODEL_DEPTH=101
WIDTH_MULT=1.0
CLASSES=83
DURATION=32
INPUT_SIZE=112
INFERENCE_STRIDE=8
CPU_THREADS=4
LABELS_PATH=
