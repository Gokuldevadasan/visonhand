# Copy to /etc/gesture-recognition.env and update every value to match the checkpoint.
PROJECT_DIR=/opt/gesture-recognition
MODEL_PATH=/opt/gesture-recognition/models/gesture.pth
CAMERA_SOURCE=0
MODEL=mobilenetv2
MODEL_DEPTH=10
WIDTH_MULT=0.5
CLASSES=83
DURATION=8
INPUT_SIZE=80
INFERENCE_STRIDE=2
CPU_THREADS=4
# Optional. It must have exactly CLASSES lines.
LABELS_PATH=
